# Copy to .env (git-ignored) and fill in the values.
# Real environment variables take precedence over this file.

# PostgreSQL
DB_URL=jdbc:postgresql://localhost:5434/job_db
DB_USERNAME=job_user
DB_PASSWORD=change-me

# Google Gemini (Spring AI)
GEMINI_API_KEY=change-me
GEMINI_MODEL=gemini-3.8-flash

# JWT - Base64-encoded key of at least 256 bits, e.g. `openssl rand -base64 32`
JWT_SECRET_KEY=change-me
JWT_EXPIRATION_MS=86400000
# Must be true in production (HTTPS only cookie)
JWT_COOKIE_SECURE=false

# Comma-separated list of allowed frontend origins
CORS_ALLOWED_ORIGINS=http://localhost:3000
